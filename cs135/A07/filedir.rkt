(require "fs-print.rkt")

;; *********** q3a *************

;; choose: FDList -> (listof Str)

;; Example:

(check-expect (choose (list (make-file "zahra.jpg" 3669000 1319216638)
                            (make-file "zahra.jpg.bak" 3669000 1319216638)
                            (make-file "timbit.jpg" 2866000 1319181806)))
              (list "zahra.jpg" "zahra.jpg.bak" "timbit.jpg"))

(define (choose fdl)
  (cond
    [(empty? fdl) empty]
    [else (append (list-files (first fdl))
                  (choose (rest fdl)))]))


;; (list-files fd) consumes a FileDir (fd)
;; The function produces a (listof Str) that contains the names of all the files in fd
;; The list should produce the files in the same order as generated by the provided fs-print function
;; list-files: (anyof file dir) -> (listof Str)

;; Example
(check-expect (list-files (make-file "readme.txt" 187 1319502441)) (list "readme.txt"))

(define (list-files fd)
  (cond
    [(file? fd) (list (file-name fd))]
    [(dir? fd) (choose (dir-contents fd))]))

;;Test:
(check-expect (list-files sample-fs) (list "readme.txt" "zahra.jpg" "timbit.jpg" "chonky.jpg"
                                           "beach1.jpg" "beach2.jpg" "beach3.jpg" "oreo.jpg"
                                           "anna.jpg" "beach1.jpg" "eagles-hotel-california.mp3"
                                           "bee-gees-stayin-alive.mp3" "lady-gaga-bad-romance.mp3"
                                           "beyonce-single-ladies.mp3" "shopping.txt" "todo.txt"))


;; *********** q3b *************

;; trace: FDList -> FDList

;; Example:

(check-expect (trace (list (make-file "song.mp3" 10 30) (make-file "song.mp3.bak" 10 30)
              (make-file "moive.mp4" 20 40) (make-file "moive.mp4.bak" 20 40)))
              (list (make-file "song.mp3" 10 30) (make-file "song.mp3.bak" 10 30)
                    (make-file "song.mp3.bak" 10 30) (make-file "song.mp3.bak.bak" 10 30)
                    (make-file "moive.mp4" 20 40) (make-file "moive.mp4.bak" 20 40)
                    (make-file "moive.mp4.bak" 20 40) (make-file "moive.mp4.bak.bak" 20 40)))

(define (trace fdl)
  (cond
    [(empty? fdl) empty]
    [(file? (first fdl))
     (cons (first fdl) (cons (make-file (string-append (file-name (first fdl)) ".bak")
                                                       (file-size (first fdl))
                                                       (file-timestamp (first fdl)))
             (trace (rest fdl))))]
    [(dir? (first fdl)) (append (list (backup (first fdl)))
                        (trace (rest fdl)))]))

;; (backup dir) consumes a Dir
;; The function produces a Dir with an extra copy (backup) of each file it contains.
;; Subdirectories also get backed up.
;; backup: (make-dir Str FDList) -> (make-dir Str FDList)

;; Example

(check-expect (backup (make-dir "string" empty)) (make-dir "string" empty))

(define (backup dir)
  (make-dir (dir-name dir) (trace (dir-contents dir))))

;; Test
(check-expect (backup (make-dir "chris" (list (make-file "song.mp3" 10 30)
                                              (make-file "moive.mp4" 20 40))))
              (make-dir "chris" (list (make-file "song.mp3" 10 30)
                                      (make-file "song.mp3.bak" 10 30)
                                      (make-file "moive.mp4" 20 40)
                                      (make-file "moive.mp4.bak" 20 40))))

;; *********** q3c *************

;; (max-time fdl acc) produces the max timestamp in a FDList
;; max-time: FDList Int -> Num

;; Example
(check-expect (max-time (list (make-file "song.mp3" 10 30) (make-file "song.mp3.bak" 10 30)
                              (make-file "moive.mp4" 20 40) (make-file "moive.mp4.bak" 20 40)) 0) 40)

(define (max-time fdl acc)
  (cond
    [(empty? fdl) acc]
    [(file? (first fdl))
     (cond
       [(<= (file-timestamp (first fdl)) acc)
        (max-time (rest fdl) acc)]
       [(> (file-timestamp (first fdl)) acc)
        (max-time (rest fdl) (file-timestamp (first fdl)))])]
    [(dir? (first fdl))
     (max (max-time (dir-contents (first fdl)) 0) (max-time (rest fdl) acc))]))

;; (get-time fd) consumes a FileDir and produces a timestamp (Nat).
;; For a File, the function produces the timestamp of the file.
;; For a Dir, the functioni produces the latest (largest) timestamp for any file
;; that appears in the FileSystem represented by Dir, or false if there are no files.
;; get-time: FileDir -> (anyof Nat false)

;; Example:

(check-expect (get-time (make-dir "chris" (list (make-file "song.mp3" 10 30)
                                                (make-file "song.mp3.bak" 10 30)
                                                (make-file "moive.mp4" 20 40)
                                                (make-file "moive.mp4.bak" 20 40)))) 40)

(define (get-time fd)
  (cond
    [(file? fd) (file-timestamp fd)]
    [(and (dir? fd) (= 0 (max-time (dir-contents fd) 0))) false]
    [else (max-time (dir-contents fd) 0)]))


;; Tests:

(check-expect (get-time (make-dir "chris" empty)) false)
(check-expect (get-time sample-fs) 1319679565)
(check-expect (get-time (make-file "moive.mp4" 20 40)) 40)
(check-expect (get-time (make-dir "empty" (list (make-dir "dir1" empty)
                                                (make-dir "dir2" empty)
                                                (make-dir "dir3" empty)))) false)


;; *********** q3d *************


;; fd-acc: Str FileDir (listof Str) (listof Str) -> (listof Str)

;; Examples:

(check-expect (fd-acc "vacation" (dir-contents sample-fs) empty empty) empty)
(check-expect (fd-acc "shopping.txt" (dir-contents sample-fs) empty empty) empty)

(define (fd-acc name fd record-path acc)
  (cond
    [(and (dir? fd) (string=? name (dir-name fd)))
     (fdlst-acc name (dir-contents fd) (cons name record-path)
                (cons (reverse (cons name record-path)) acc))]
    [(dir? fd) (fdlst-acc name (dir-contents fd) (cons (dir-name fd) record-path) acc)]
    [(and (file? fd) (string=? name (file-name fd))) (cons (reverse (cons name record-path)) acc)]
    [else acc]))

;; fdlst-acc: Str FDList (listof Str) (listof Str) -> (listof Str)

;; Examples:

(check-expect (fdlst-acc "vacation" (dir-contents sample-fs) empty empty)
              (list (list "photos" "vacation")))

(check-expect (fdlst-acc "shopping.txt" (dir-contents sample-fs) empty empty)
              (list (list "notes" "shopping.txt")))

(define (fdlst-acc name fdlst record-path acc)
  (cond
    [(empty? fdlst) acc]
    [else (fdlst-acc name (rest fdlst) record-path (fd-acc name (first fdlst) record-path acc))]))

;; (find name dir) comsumes two parameters name, dir and it finds every file and directory
;; contained in dir that has the given name.
;; The function produces a list of paths to those files and directories or empty
;; if there is no file or directory with the given name.
;; find: Str FileDir -> (listof (listof Str))

;; Examples:

(check-expect (find "vacation" sample-fs) (list (list "root" "photos" "vacation")))
(check-expect (find "shopping.txt" sample-fs) (list (list "root" "notes" "shopping.txt")))

(define (find name dir)
  (fd-acc name dir empty empty))

;; Tests

(check-expect (find "beach1.jpg" sample-fs)
              (list (list "root" "photos" "beach1.jpg")
                    (list "root" "photos" "vacation" "beach1.jpg")))
(check-expect (find "readme.txt" (make-file "readme.txt" 187 1319502441))
              (list (list "readme.txt")))